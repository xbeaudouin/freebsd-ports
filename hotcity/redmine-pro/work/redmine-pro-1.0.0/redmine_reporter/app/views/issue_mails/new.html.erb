<h2><%= l(:label_reporter_send_by_email) %></h2>
<%= error_messages_for 'issue_mail' %>

<%= form_for(:email_message, url: send_mail_issue_mails_path(issue_id: @issue.id), html: { id: 'message-form', multipart: true }) do %>
  <div class="box tabular">
    <p>
      <label><%= l(:label_reporter_mail_from) %> <span class="required">*</span></label>
      <span class="default-from-address"><%= human_readable_address(@issue_mail.from) %></span>
      <%= link_to_function image_tag('edit.png'), '$(".default-from-address").hide(); $("#issue_mail_from").show()', class: 'default-from-address' %>

      <%= text_field_tag('issue_mail[from]', @issue_mail.from, style: 'width: 98%; display: none;') %>
    </p>

    <p>
      <label><%= l(:label_reporter_mail_to) %> <span class="required">*</span></label>
      <%= text_field_tag 'issue_mail[to]', @issue_mail.to, style: 'width: 98%;' %>
      <%= link_to "#{l(:label_reporter_mail_cc)}/#{l(:label_reporter_mail_bcc)}", '#',
                  onclick: "$('#mail_cc').show(); $('#mail_cc #issue_mail_cc').val('#{j(@issue_mail.cc || User.current.mail)}'); $(this).hide();" %>
    </p>

    <span id="mail_cc" style="display:none;">
      <p>
        <label><%= l(:label_reporter_mail_cc) %></label>
        <%= text_field_tag 'issue_mail[cc]', @issue_mail.cc, style: 'width: 98%;' %>
      </p>
      <p>
        <label><%= l(:label_reporter_mail_bcc) %></label>
        <%= text_field_tag 'issue_mail[bcc]', @issue_mail.bcc, style: 'width: 98%;' %>
      </p>
    </span>

    <p>
      <label><%= l(:field_subject) %></label>
      <%= text_field_tag 'issue_mail[subject]', @issue_mail.subject, style: 'width: 98%;' %>
    </p>
    <p>
      <label><%= l(:label_reporter_message) %></label>
      <%= text_area_tag 'issue_mail[message]', @issue_mail.message, cols: 60, rows: 10, class: 'wiki-edit' %>
      <%= wikitoolbar_for 'issue_mail_message' %>
    </p>

    <p id="attachments_form"><label><%= l(:label_attachment_plural) %></label><%= render partial: 'attachments/form', locals: { container: @issue_mail } %></p>
  </div>

  <p>
    <%= submit_tag l(:button_submit) %>
    <%= link_to l(:label_preview), '#', onclick: "submitMessageFormPreview('#{j preview_issue_mails_path(issue_id: @issue.id)}'); return false;" %>
  </p>
<% end %>

<div id="preview" class="wiki"></div>
