<div class="contextual">
  <%= link_to l(:button_export), export_report_template_path(@report_template), class: 'icon icon-save' %>
</div>

<h2><%=l(:label_reporter_report_template)%></h2>

<%= labelled_form_for :report_template, @report_template, url: { action: 'update', project_id: @project } do |f| %>
  <%= render partial: 'report_templates/form', locals: { f: f } %>
  <%= submit_tag l(:button_save) %>
<% end %>