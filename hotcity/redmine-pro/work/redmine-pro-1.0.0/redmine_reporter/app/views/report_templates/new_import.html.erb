<h2><%=l(:label_reporter_import_report_template)%></h2>

<%= form_tag(import_report_templates_path(project_id: @project), multipart: true) do %>
  <div class="box tabular">
    <p>
      <label for="rewrite"> <%= l(:label_reporter_import_file) %></label>
      <%= file_field_tag 'file', accept: 'text/yaml' %>
    </p>
    <p>
      <label for="rewrite"> <%= l(:label_reporter_rewrite_existed) %></label>
      <%= check_box_tag 'rewrite' %>
    </p>
  </div>
  <%= submit_tag l(:button_import) %>
<% end %>
