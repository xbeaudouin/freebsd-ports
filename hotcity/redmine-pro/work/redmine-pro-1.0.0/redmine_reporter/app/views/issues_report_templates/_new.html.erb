<h3 class="title"><%= l(:label_report_plural) %></h3>

<%= form_tag(issues_report_templates_path(@preview_url_options), method: :post, id: 'new-issue-reports-form') do %>
  <p><%= label_tag 'report_template_search', l(:label_reporter_template_search) %><%= text_field_tag 'report_template_search', nil %></p>
  <%= javascript_tag "observeSearchfield('report_template_search', 'report_templates', '#{j autocomplete_issues_report_templates_path(issue_id: @issue.try(:id))}')" %>

  <div id="report_templates">
    <%= report_templates_check_box_tags 'report_template[ids][]', report_templates %>
  </div>

  <p class="other-formats" style="display: none">
    <% if @issue.present? && User.current.allowed_to?(:send_issues, @project, global: true) %>
      <span>
        <%= link_to l(:button_reporter_send), '#', class: 'icon icon-email',
                    onclick: "window.location = '#{ new_issue_mail_path(issue_id: @issue.id) }&' + $('#new-issue-reports-form').serialize(); hideModal(this);" %>
      </span>
    <% end %>

    <% if !params[:query_id] && @issue_ids.size == 1 %>
      <span>
        <%= link_to l(:button_reporter_attach), '#', class: 'icon icon-attachment',
                    onclick: "$('#new-issue-reports-form').attr('action', '#{ attach_issues_report_templates_path(issue_ids: @issue_ids) }').submit(); hideModal(this);" %>
      </span>
    <% end %>

    <% if User.current.allowed_to?(:view_issue_reports, @project, global: true) %>
      <span>
        <%= link_to l(:label_preview), '#', class: 'icon icon-preview',
                    onclick: "window.location = '#{ preview_issues_report_templates_path(@preview_url_options) }&' + $('#new-issue-reports-form').serialize()" %>
      </span>
    <% end %>
  </p>

  <p class="buttons">
    <%= submit_tag l(:button_create), name: nil, onclick: 'hideModal(this);' %>
    <%= submit_tag l(:button_cancel), name: nil, onclick: 'hideModal(this);', type: 'button' %>
  </p>
<% end %>
