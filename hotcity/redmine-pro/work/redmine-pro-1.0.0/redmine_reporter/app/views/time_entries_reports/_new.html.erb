<h3 class="title"><%= l(:label_report_plural) %></h3>

<%= form_tag(time_entries_reports_path(@preview_url_options), method: :post, id: 'new-time-entries-reports-form') do %>
  <p><%= label_tag 'report_template_search', l(:label_reporter_template_search) %><%= text_field_tag 'report_template_search', nil %></p>
  <%= javascript_tag "observeSearchfield('report_template_search', 'report_templates', '#{j autocomplete_time_entries_reports_path}')" %>

  <div id="report_templates">
    <%= report_templates_check_box_tags 'report_template[ids][]', report_templates %>
  </div>

  <p class="other-formats" style="display: none">
    <% if User.current.allowed_to?(:view_time_entries_reports, @project, global: true) %>
      <span>
        <%= link_to l(:label_preview), '#', class: 'icon icon-preview',
                    onclick: "window.location = '#{ preview_time_entries_reports_path(@preview_url_options) }&' + $('#new-time-entries-reports-form').serialize()" %>
      </span>
    <% end %>
  </p>

  <p class="buttons">
    <%= submit_tag l(:button_create), name: nil, onclick: 'hideModal(this);' %>
    <%= submit_tag l(:button_cancel), name: nil, onclick: 'hideModal(this);', type: 'button' %>
  </p>
<% end %>
