#!/bin/sh
#
# PROVIDE: eloipool
# REQUIRE: LOGIN bitcoind
# KEYWORD: shutdown
#
# Add to /etc/rc.conf to enable:
#
# eloipool_enable="YES"
#
# Optional rc.conf variables:
# eloipool_user="eloipool"
# eloipool_group="eloipool"
# eloipool_config="%%PREFIX%%/etc/eloipool/config.py"
# eloipool_logfile="/var/log/eloipool.log"
# eloipool_flags=""

. /etc/rc.subr

name="eloipool"
desc="Python3 Bitcoin pool server with merged mining support"
rcvar="eloipool_enable"

load_rc_config "${name}"

: ${eloipool_enable:="NO"}
: ${eloipool_user:="eloipool"}
: ${eloipool_group:="eloipool"}
: ${eloipool_config:="%%PREFIX%%/etc/eloipool/config.py"}
: ${eloipool_logfile:="/var/log/eloipool.log"}
: ${eloipool_pidfile:="/var/run/eloipool.pid"}
: ${eloipool_flags:=""}

pidfile="${eloipool_pidfile}"
command="%%PREFIX%%/bin/eloipool"
command_args="--config ${eloipool_config} ${eloipool_flags}"

start_precmd="${name}_prestart"
stop_postcmd="${name}_postcmd"

eloipool_prestart()
{
	if [ ! -f "${eloipool_config}" ]; then
		err 1 "Config file not found: ${eloipool_config}"
		err 1 "Copy and edit the sample: cp %%PREFIX%%/etc/eloipool/config.py.sample ${eloipool_config}"
	fi
	# Ensure log file is writable by eloipool user
	if [ ! -f "${eloipool_logfile}" ]; then
		install -o "${eloipool_user}" -g "${eloipool_group}" \
			-m 0640 /dev/null "${eloipool_logfile}"
	fi
}

eloipool_postcmd()
{
	rm -f "${eloipool_pidfile}"
}

run_rc_command "$1"
