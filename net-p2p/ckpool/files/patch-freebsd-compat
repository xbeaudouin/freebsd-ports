@@ -1,6 +1,14 @@
+#ifdef __FreeBSD__
+#include <pthread_np.h>
+#else
 #include <sys/prctl.h>
+#endif
 
 /* Thread naming wrapper */
 static void set_thread_name(const char *name)
 {
+#ifdef __FreeBSD__
+	pthread_set_name_np(pthread_self(), name);
+#else
 	prctl(PR_SET_NAME, name, 0, 0, 0);
+#endif
 }
