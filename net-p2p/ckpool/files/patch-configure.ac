--- configure.ac.orig	2026-05-28 09:59:44 UTC
+++ configure.ac
@@ -12,6 +12,25 @@ AC_CANONICAL_HOST
 AC_CANONICAL_BUILD
 AC_CANONICAL_HOST
 
+# FreeBSD
+AM_CONDITIONAL([FREEBSD], [AS_CASE([$host_os],[freebsd*],[true],[false])])
+
+AS_CASE([$host_os],
+  [freebsd*],[
+    # Allow overriding LOCALBASE (default: /usr/local)
+    AC_ARG_VAR([LOCALBASE], [FreeBSD ports base directory @<:@/usr/local@:>@])
+    AS_IF([test -z "$LOCALBASE"], [LOCALBASE="/usr/local"])
+    AC_SUBST([LOCALBASE])
+
+    # Verify libepoll-shim is present
+    saved_CPPFLAGS="$CPPFLAGS"
+    CPPFLAGS="$CPPFLAGS -I$LOCALBASE/include/libepoll-shim"
+    AC_CHECK_HEADER([sys/epoll.h], [],
+      [AC_MSG_ERROR([libepoll-shim not found. Install devel/libepoll-shim])])
+    CPPFLAGS="$saved_CPPFLAGS"
+  ]
+)
+
 dnl Make sure anyone changing configure.ac/Makefile.am has a clue
 AM_MAINTAINER_MODE
 
